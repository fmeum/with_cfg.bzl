"""Setting names and the native attribute constructors they select."""

type _AttrType = Literal["bool", "int", "int_list", "label", "label_list", "string", "string_list"]

def make_valid_identifier(name: str) -> str: ...
def validate_and_get_attr_name(setting: str | Label) -> str: ...
def get_attr_type(attr: object) -> _AttrType: ...
def _get_type_as_attr_type(value: object) -> _AttrType | None: ...
