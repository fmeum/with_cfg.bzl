"""Providers returned by the argument-expansion aspect."""

load(":providers.bzl", "ArgsInfo")

def _args_aspect_impl(target: Target, ctx) -> list[OutputGroupInfo | ArgsInfo]: ...

class _MakeFilegroup(Protocol):
    def __call__(self, *, name: str, srcs: list[str], output_group: str) -> object: ...

@overload
def rewrite_args(
        name: str,
        args: list[str],
        make_filegroup: _MakeFilegroup,
) -> tuple[list[str], list[Label]]: ...

@overload
def rewrite_args(
        name: str,
        args: select[list[str]],
        make_filegroup: _MakeFilegroup,
) -> tuple[select[list[str]], list[Label]]: ...

@overload
def rewrite_args(
        name: str,
        args: None,
        make_filegroup: _MakeFilegroup,
) -> tuple[None, list[Label]]: ...

@overload
def rewrite_args(
        name: str,
        args: select[list[str] | None],
        make_filegroup: _MakeFilegroup,
) -> tuple[select[list[str] | None], list[Label]]: ...

def rewrite_args(
        name: str,
        args: list[str] | select[list[str] | None] | None,
        make_filegroup: _MakeFilegroup,
) -> tuple[list[str] | select[list[str] | None] | None, list[Label]]: ...
