"""Inherited rule creation and transition setting initialization."""

# TODO(https://github.com/bazelbuild/bazel/pull/30373): Move the generic parent and
# initializer signatures into extend.bzl once Bazel 7 support ends and the minimum accepts
# type parameters on def. A signature comment cannot bind R or K.
def make_transitioned_rule[K: str | Label](
        *,
        parent: rule,
        transition: transition[Literal["split"]],
        values: Mapping[K, object],
) -> rule: ...

class _ParentContext[R](Protocol):
    def super(self) -> R: ...

def _transitioned_rule_impl[R](ctx: _ParentContext[R]) -> R: ...

def _initializer_base[K: str | Label](
        *,
        kwargs: dict[str, object],
        values: Mapping[K, object],
) -> dict[str, object]: ...

class _Initializer(Protocol):
    def __call__(self, **kwargs: object) -> dict[str, object]: ...
