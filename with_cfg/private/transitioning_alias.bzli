"""Provider forwarding through a single-output split transition."""

# TODO(https://github.com/bazelbuild/bazel/pull/30373): Move make_transitioning_alias into
# its implementation when the minimum Bazel accepts the key type parameter on def; a comment
# cannot bind K.
type _Attrs = struct[{"exports": Sequence[Target]}, ...]
type _Context = ctx[object, _Attrs]

def make_transitioning_alias[K: str | Label](
        *,
        providers: Sequence[ProviderKey],
        transition: transition[Literal["split"]],
        values: Mapping[K, object],
        original_settings_label: str | Label | None,
) -> rule: ...
