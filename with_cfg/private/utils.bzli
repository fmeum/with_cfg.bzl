"""Predicates over arbitrary Starlark values."""

def is_bool(value: object) -> bool: ...
def is_dict(value: object) -> bool: ...
def is_int(value: object) -> bool: ...
def is_label(value: object) -> bool: ...
def is_list(value: object) -> bool: ...
def is_select(value: object) -> bool: ...
def is_string(value: object) -> TypeIs[str]: ...
